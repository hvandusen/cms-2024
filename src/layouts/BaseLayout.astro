---
// The real stylesheet, ported from src/components/all.scss. It pulls in
// WorkTypeColors, mixins and paperAddOns itself, so this one import is the
// whole cascade. Fonts are served from /fonts (astro/public/fonts).
import '../styles/all.scss'
import Navbar from '../components/Navbar.astro'

interface Props {
  title: string
  description?: string
  ogImage?: string
  /** Matches Gatsby's <Layout pageClass> — styles hang off #page.about etc. */
  pageClass?: string
}

const { title, description, ogImage, pageClass } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />
    <link rel="icon" type="image/png" href="/img/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/img/favicon-16x16.png" sizes="16x16" />
    <link rel="mask-icon" href="/img/safari-pinned-tab.svg" color="#ff4400" />
    <meta name="theme-color" content="#fff" />

    <meta property="og:type" content="business.business" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
  </head>
  <body>
    <Navbar />

    <!-- Footer is still not ported. -->
    <div id="page" class={pageClass}>
      <slot />
    </div>
  </body>
</html>
