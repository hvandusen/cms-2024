---
import { getEntry, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

// about.js queried the single markdown file with templateKey: about.
const entry = await getEntry('about', 'index')
if (!entry) throw new Error('src/pages/about/index.md is missing')
const { Content } = await render(entry)
---

<BaseLayout title={entry.data.title} pageClass="about">
  <div id="about-wrapper">
    <div id="about-image">
      <img src="/hvd_pic.jpg" alt="Henry Van Dusen" />
    </div>
    <div id="about-page">
      <h1 id="about-title">{entry.data.title}</h1>
      <Content />
    </div>
  </div>
</BaseLayout>
